{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NestJS API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "cwd": "${workspaceFolder}/apps/api",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/api/dist/**/*.js"]
    },
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/apps/ai-service",
      "python": "${workspaceFolder}/apps/ai-service/venv/bin/python"
    }
  ],
  "compounds": [
    {
      "name": "All Services",
      "configurations": ["NestJS API", "FastAPI"]
    }
  ]
}
{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": ["NEXTAUTH_SECRET", "NEXTAUTH_URL", "INTERNAL_API_KEY"]
    },
    "dev": { "persistent": true, "cache": false },
    "lint": {},
    "test": { "dependsOn": ["^build"] }
  }
}
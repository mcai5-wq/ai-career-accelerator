# Copy this file to infra/.env.production and fill in real values.
# Never commit the filled-in file — infra/.env.production is gitignored.
#
# Usage:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.production up -d --build

# --- Postgres ---
# Whatever you want — these just create the container's own database, not
# a connection to something pre-existing.
POSTGRES_USER=prod
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=ai_career_prod

# --- Public URLs ---
# The real, internet-reachable URLs this stack will be served at once DNS
# and (if you add one) a reverse proxy are set up — not localhost, and not
# a compose-internal service name.
FRONTEND_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# --- Secrets (generate with: openssl rand -base64 32) ---
JWT_SECRET=
NEXTAUTH_SECRET=
# Shared secret between web and api for server-to-server calls (the OAuth
# token exchange, and api -> ai-service). Same value on both sides.
INTERNAL_API_KEY=

# --- AI (Groq's free tier by default — see apps/ai-service/app/core/config.py) ---
AI_API_KEY=
# Only needed if switching providers — Groq's defaults are baked into
# ai-service itself:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# --- Email (2FA codes, password reset — optional; codes log to container
# stdout instead of sending if these are left blank, same as local dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Google OAuth (optional — Google sign-in is just hidden if unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Donations (optional — disabled entirely in app.module.ts right now;
# only needed once that feature is turned back on) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
